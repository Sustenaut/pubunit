{
  "kind": "rust",
  "ci": {
    "with": {
      "gates": "guard-floats ucum-table-check",
      "functional": "script-tests",
      "sonar-args": "-Dsonar.cpd.exclusions=**/*.generated.rs"
    },
    "release": {
      "pubrel": "0.6.1"
    }
  },
  "bin": "pubunit",
  "protect": {
    "checks": [
      "ci / passed",
      "release / release"
    ]
  }
}

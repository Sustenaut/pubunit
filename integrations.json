{
  "uses": [
    {
      "plugin": "crates-io.publish",
      "paths": [
        "src/lib.rs"
      ]
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml",
        ".github/workflows/queue.yml"
      ]
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/nightly.yml",
        ".github/workflows/pr.yml",
        ".github/workflows/queue.yml"
      ]
    }
  ],
  "other_hosts": [
    {
      "host": "qudt.org",
      "reason": "An RDF namespace, not fetched"
    },
    {
      "host": "www.qudt.org",
      "reason": "A link in the documentation"
    }
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes and test data"
    }
  ]
}

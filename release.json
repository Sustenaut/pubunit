{
  "name": "pubunit",
  "package": "pkg.pubunit",
  "tag": "PKG-PUBUNT-10-2026",
  "corpus": "corpus",
  "manifest": {
    "kind": "cargo-package",
    "path": "Cargo.toml"
  },
  "code": [
    "src/",
    "Cargo.toml",
    "Cargo.lock"
  ],
  "command": {
    "name": "pubunit",
    "check": "pubunit --version"
  },
  "install": "cargo install --locked pubunit --version {version}, or cargo add pubunit@{version}",
  "key": "pub:sha2-256:wsozvmedybthbybojab3fxn3sg3dtivfqbpnysufebv5yxyxbrcq",
  "semver-checks": true,
  "security": {
    "checks": [
      {
        "name": "advisories, licences, bans and sources",
        "run": "cargo deny --locked check --hide-inclusion-graph",
        "version": "cargo deny --version"
      },
      {
        "name": "supply-chain audits",
        "run": "cargo vet --locked",
        "version": "cargo vet --version"
      },
      {
        "name": "supply-chain report current",
        "run": ".venv/bin/pubkit supply-chain --check pubunit",
        "version": ".venv/bin/pubkit --version"
      },
      {
        "name": "UCUM table matches the pinned ucum-units",
        "run": "python3 tools/gen-ucum-table.py --check",
        "version": "cargo tree --depth 1 --prefix none -e normal | grep ucum-units"
      },
      {
        "name": "QUDT kinds match the pinned QUDT release",
        "run": "make -s qudt-kinds-check",
        "version": "python3 -c \"import json; print('QUDT', json.load(open('data/qudt/source.json'))['version'])\""
      },
      {
        "name": "quality audit current",
        "run": ".venv/bin/pubkit audit --check",
        "version": ".venv/bin/pubkit --version"
      }
    ],
    "facts": [
      {
        "name": "RustSec advisory database revision",
        "run": "git -C \"$(ls -d ~/.cargo/advisory-dbs/advisory-db-*/ | head -1)\" log -1 --format='%H (%cs)'"
      },
      {
        "name": "audits imported from",
        "run": "grep -o '^\\[imports\\.[a-z-]*' supply-chain/config.toml | cut -d. -f2 | paste -sd, - | sed 's/,/, /g'"
      }
    ]
  }
}
